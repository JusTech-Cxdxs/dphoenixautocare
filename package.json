{
  "name": "dphoenixautocare",
  "version": "0.1.0",
  "private": true,
  "description": "D'Phoenix Autocare workshop and fleet system, an EJO edition by JusTech.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --trace off",
    "load": "tsx --env-file-if-exists=.env scripts/load-test.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "node --env-file-if-exists=.env scripts/db-deploy.mjs --force",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:check": "node --env-file-if-exists=.env scripts/check-migrations.mjs",
    "vercel-build": "prisma generate && node scripts/db-deploy.mjs && next build"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "better-auth": "1.7.27",
    "geist": "1.9.2",
    "next": "15.5.29",
    "nodemailer": "10.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/nodemailer": "6.4.24",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.29",
    "pg": "8.23.1",
    "prisma": "5.22.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "next": {
      ".": "15.5.29",
      "postcss": "8.5.33"
    },
    "postcss": "8.5.33"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "prisma@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.28.2": true
  }
}
