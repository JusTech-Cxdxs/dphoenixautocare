# Names only. Set real values in .env (local, never committed) or in Vercel.
# Required in production unless marked optional.

# Database (Supabase): pooled connection (port 6543, ?pgbouncer=true) and direct connection (port 5432)
DATABASE_URL=
DIRECT_URL=

# Sign-in. BETTER_AUTH_URL is this app's public address, e.g. https://app.dphoenixautocare.com
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Email over SMTP (no paid email service)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Live updates (optional; public by design)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# First Owner login (scripts: npm run db:seed). OWNER_PASSWORD optional; without it the Owner uses "Forgot password".
OWNER_EMAIL=
OWNER_NAME=
OWNER_PASSWORD=

# Optional tuning
RATE_LIMIT_SALT=
PRISMA_CONNECTION_LIMIT=
PRISMA_POOL_TIMEOUT=
# Which header holds the real client address when not on Vercel: TRUST_CLOUDFLARE=1 behind
# Cloudflare only, TRUSTED_PROXY=1 behind your own proxy. Without either, all clients share one limit.
TRUST_CLOUDFLARE=
TRUSTED_PROXY=

# Local tests only (throwaway databases, never production)
TEST_DATABASE_URL=
SHADOW_DATABASE_URL=
E2E_DATABASE_URL=
E2E_PASSWORD=
# Test-only switches, ignored unless BETTER_AUTH_URL is a localhost address
MAIL_OUTBOX=
AUTH_ATTEMPT_LIMIT_SCALE=
